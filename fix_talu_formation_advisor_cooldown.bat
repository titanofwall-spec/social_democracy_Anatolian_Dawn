@echo off
setlocal EnableExtensions DisableDelayedExpansion
title Anatolian Dawn - Talu formation advisor cooldown
set "REPO=%~dp0"
if not exist "%REPO%package.json" (
 echo Put this BAT in the Anatolian Dawn repository root.
 pause
 exit /b 1
)
cd /d "%REPO%"
where node >nul 2>&1 || (echo ERROR: Node.js required.& pause & exit /b 1)
where git >nul 2>&1 || (echo ERROR: Git required.& pause & exit /b 1)
git diff --quiet && git diff --cached --quiet
if errorlevel 1 (
 echo ERROR: Commit or stash existing changes first.
 pause
 exit /b 1
)
set "PATCH=%TEMP%\talu_advisor_patch_%RANDOM%.js"
powershell -NoProfile -ExecutionPolicy Bypass -Command "[IO.File]::WriteAllBytes($env:PATCH,[Convert]::FromBase64String(''))"
if errorlevel 1 goto failed
node "%PATCH%"
set "RC=%ERRORLEVEL%"
del "%PATCH%" >nul 2>&1
if not "%RC%"=="0" goto failed
echo.
echo Building and testing...
call npm run build
if errorlevel 1 goto failed
call npm test
if errorlevel 1 goto failed
git diff --check
if errorlevel 1 goto failed
git diff --stat
echo.
choice /C YN /M "Commit and push verified changes to origin/main"
if errorlevel 2 goto finished
git add -- out/html/card-actions.js scripts/test-advisor-cooldowns.js source/scenes
if errorlevel 1 goto failed
git commit -m "Restore advisor cooldown on actual Talu government formation"
if errorlevel 1 goto failed
git push origin main
if errorlevel 1 goto failed
echo SUCCESS: Pushed to GitHub.
goto finished
:failed
echo.
echo STOPPED: No automatic deployment. Review the error above.
:finished
pause
endlocal
