title: The diplomatic conference
view-if: {! return AnatolianRules.cyprusCampaign.meetingPending(Q); !}
on-arrival: {! Q.cyprus_campaign_report=AnatolianRules.cyprusCampaign.meetingBrief(Q); !}
new-page: true

= [+ cyprus_date_display +], Negotiations

[+ cyprus_campaign_report +]

- @guarantees: Offer reciprocal security guarantees and advance the federal negotiations.
- @protection: Prioritize UN monitoring and civilian protection arrangements.
- @reject: Reject further concessions and maintain Turkey's demands.

@guarantees
choose-if: {! return AnatolianRules.cyprusCampaign.meetingAvailable(Q,'guarantees'); !}
unavailable-subtitle: The current foreign attitudes do not permit this approach.
on-arrival: {! AnatolianRules.cyprusCampaign.resolveMeeting(Q,'guarantees'); !}
new-page: true

