title: The Cyprus conference
view-if: {! return AnatolianRules.cyprusRoadmap.active(Q) && AnatolianRules.cyprusCampaign.pending(Q)==='cyprus_roadmap_event'; !}
new-page: true
on-arrival: {! AnatolianRules.cyprusRoadmap.prepareEvent(Q); !}

= [+ cyprus_roadmap_event_title +]

[+ cyprus_roadmap_event_text +]

- @geneva_response: [+ {! return AnatolianRules.cyprusRoadmap.responseLabel(Q); !} +]
- @demand: Present our demand, document the violations and reinforce the line.
- @monitor: Seek UN monitoring and civilian protection while reinforcing the line.
- @gunes: Pursue the Güneş Plan: six autonomous Turkish cantons.
- @denktas: Pursue the Denktaş Plan: a northern Turkish federal region.
- @ii_response: [+ {! return AnatolianRules.cyprusRoadmap.responseLabel(Q); !} +]
- @constitutional: Give up territorial autonomy and negotiate a revised 1960 constitutional order.
- @war: End the talks and begin Atilla II.
- @turkish: Insist on the Turkish proposal (2 Leverage Points).
- @compromise: Accept the compromise (1 Leverage Point).
- @greek: Accept the Greek proposal (gain 0.5 Leverage Points).
- @ceasefire: Declare the ceasefire at 18:00 today.
- @delay: Postpone the ceasefire until 08:00 tomorrow.
- @division: Receive the territorial settlement report.
- @consult: Continue consultations and rebuild negotiating leverage.
- @sign_treaty: Sign the negotiated constitutional treaty.
- @refuse_treaty: Refuse the treaty and begin Atilla II.
- @continue: Continue.

@geneva_response
view-if: {! return AnatolianRules.cyprusRoadmap.genevaResponse(Q); !}
on-arrival: {! AnatolianRules.cyprusRoadmap.resolveEvent(Q,'respond'); !}
go-to: cyprus_campaign_continue

@ii_response
view-if: {! return Q.cyprus_campaign_phase==='atilla2' && [0,1,3].includes(AnatolianRules.cyprusRoadmap.iiStep(Q)); !}
on-arrival: {! AnatolianRules.cyprusCampaign.resolveII(Q,Q.cyprus_day,'historical',this.random.random.bind(this.random)); !}
go-to: cyprus_campaign_continue

@demand
view-if: {! return AnatolianRules.cyprusRoadmap.ceasefireAvailable(Q) && !AnatolianRules.cyprusRoadmap.genevaResponse(Q); !}
on-arrival: {! AnatolianRules.cyprusRoadmap.resolveEvent(Q,'demand'); !}
go-to: report

@monitor
view-if: {! return AnatolianRules.cyprusRoadmap.ceasefireAvailable(Q) && !AnatolianRules.cyprusRoadmap.genevaResponse(Q); !}
on-arrival: {! AnatolianRules.cyprusRoadmap.resolveEvent(Q,'monitor'); !}
go-to: report

@gunes
view-if: {! return AnatolianRules.cyprusRoadmap.eventIs(Q,'geneva2-12'); !}
on-arrival: {! AnatolianRules.cyprusRoadmap.resolveEvent(Q,'gunes'); !}
go-to: report

@denktas
view-if: {! return AnatolianRules.cyprusRoadmap.eventIs(Q,'geneva2-12'); !}
on-arrival: {! AnatolianRules.cyprusRoadmap.resolveEvent(Q,'denktas'); !}
go-to: report

@offensive
view-if: {! return Q.cyprus_campaign_phase==="atilla2" && AnatolianRules.cyprusRoadmap.iiStep(Q)!==2 && AnatolianRules.cyprusRoadmap.iiStep(Q)<4; !}
on-arrival: {! AnatolianRules.cyprusCampaign.resolveII(Q,Q.cyprus_day,'historical',this.random.random.bind(this.random)); !}
go-to: report

@supply
view-if: {! return Q.cyprus_campaign_phase==="atilla2" && AnatolianRules.cyprusRoadmap.iiStep(Q)!==2 && AnatolianRules.cyprusRoadmap.iiStep(Q)<4; !}
on-arrival: {! AnatolianRules.cyprusCampaign.resolveII(Q,Q.cyprus_day,'alternative',this.random.random.bind(this.random)); !}
go-to: report

@continue
view-if: {! return AnatolianRules.cyprusRoadmap.ordinaryEvent(Q) && !AnatolianRules.cyprusRoadmap.genevaResponse(Q); !}
on-arrival: {! AnatolianRules.cyprusRoadmap.resolveEvent(Q,'continue'); !}
go-to: cyprus_campaign_continue

@report
new-page: true

= Report

[+ cyprus_roadmap_report +]

- @cyprus_campaign_continue: Continue.

@constitutional
view-if: {! return AnatolianRules.cyprusRoadmap.eventIs(Q,'geneva2-14') && !Q.cyprus_gunes_backing; !}
on-arrival: {! AnatolianRules.cyprusRoadmap.resolveEvent(Q,'constitution'); !}
go-to: report

@war
view-if: {! return Q.cyprus_campaign_phase==='constitutional' || (AnatolianRules.cyprusRoadmap.eventIs(Q,'geneva2-14') && !Q.cyprus_gunes_backing); !}
on-arrival: {! if(Q.cyprus_campaign_phase==='constitutional')AnatolianRules.cyprusRoadmap.resolveConstitution(Q,'war');else AnatolianRules.cyprusRoadmap.resolveEvent(Q,'war'); !}
go-to: cyprus_campaign_continue

@turkish
view-if: {! return Q.cyprus_campaign_phase==='constitutional' && (true); !}
choose-if: {! return AnatolianRules.cyprusRoadmap.constitutionChoiceAvailable(Q,'turkish'); !}
unavailable-subtitle: Requires 2 Leverage Points.
on-arrival: {! AnatolianRules.cyprusRoadmap.resolveConstitution(Q,'turkish'); !}
go-to: report

@compromise
view-if: {! return Q.cyprus_campaign_phase==='constitutional' && (true); !}
choose-if: {! return AnatolianRules.cyprusRoadmap.constitutionChoiceAvailable(Q,'compromise'); !}
unavailable-subtitle: Requires 1 Leverage Points.
on-arrival: {! AnatolianRules.cyprusRoadmap.resolveConstitution(Q,'compromise'); !}
go-to: report

@greek
view-if: {! return Q.cyprus_campaign_phase==='constitutional' && (AnatolianRules.cyprusRoadmap.constitutionChoiceAvailable(Q,"greek")); !}
choose-if: {! return AnatolianRules.cyprusRoadmap.constitutionChoiceAvailable(Q,'greek'); !}
unavailable-subtitle: Requires 0 Leverage Points.
on-arrival: {! AnatolianRules.cyprusRoadmap.resolveConstitution(Q,'greek'); !}
go-to: report

@ceasefire
view-if: {! return Q.cyprus_campaign_phase==='atilla2' && AnatolianRules.cyprusRoadmap.iiStep(Q)===2; !}
on-arrival: {! AnatolianRules.cyprusCampaign.resolveII(Q,Q.cyprus_day,'ceasefire',this.random.random.bind(this.random)); !}
go-to: report

@delay
view-if: {! return Q.cyprus_campaign_phase==='atilla2' && AnatolianRules.cyprusRoadmap.iiStep(Q)===2; !}
new-page: true

= Are you sure?

Our army has fulfilled the task designated for the Second Cyprus Peace Operation. We have taken the line of Mağusa–Lefke, and the Turkish Cypriots have been given a substantial and well-defended territory, which seemed impossible to achieve when our troops first landed on Cyprus. The General Staff is ready to agree to a ceasefire at 18:00, thus terminating military operations.

In the opinion of our commanders, another fourteen-hour operation up to 08:00 tomorrow could yield significant results — particularly, the capture of Nicosia Airport, which was beyond our reach during the confrontation with the British in July.

But at what cost might such a decision be purchased? Britain has already warned of military confrontations over the issue of the airport, while the United States has grown increasingly hostile to our continued expansion. The United Nations is calling for an immediate ceasefire, and economic sanctions and a deterioration of the exchange situation may inflict considerable damage on our economy.

We have already attained our goal, and another fourteen-hour offensive might transform our victory into a diplomatic and economic defeat, the consequences of which our country would have to bear for a long time.

Is it worth risking all of this for the sake of another fourteen hours of warfare?

- @confirm_delay: Yes. Continue until 08:00 tomorrow.
- @cancel_delay: No. Declare the ceasefire at 18:00 today.

@confirm_delay
on-arrival: {! AnatolianRules.cyprusCampaign.resolveII(Q,Q.cyprus_day,'confirm-delay',this.random.random.bind(this.random)); !}
go-to: report

@cancel_delay
on-arrival: {! AnatolianRules.cyprusCampaign.resolveII(Q,Q.cyprus_day,'ceasefire',this.random.random.bind(this.random)); !}
go-to: report

@division
view-if: {! return Q.cyprus_campaign_phase==='atilla2' && AnatolianRules.cyprusRoadmap.iiStep(Q)===4; !}
on-arrival: {! AnatolianRules.cyprusCampaign.resolveII(Q,Q.cyprus_day,'ending',this.random.random.bind(this.random)); !}
go-to: cyprus_campaign_continue

@consult
view-if: {! return Q.cyprus_campaign_phase==='constitutional' && !AnatolianRules.cyprusRoadmap.constitutionChoiceAvailable(Q,'greek') && AnatolianRules.number(Q.leverage_points)<1; !}
on-arrival: {! AnatolianRules.cyprusRoadmap.resolveConstitution(Q,'consult'); !}
go-to: report

@sign_treaty
view-if: cyprus_campaign_phase == "constitutional_treaty"
on-arrival: {! AnatolianRules.cyprusRoadmap.resolveEvent(Q,'sign'); !}
go-to: cyprus_campaign_continue

@refuse_treaty
view-if: cyprus_campaign_phase == "constitutional_treaty"
on-arrival: {! AnatolianRules.cyprusRoadmap.resolveEvent(Q,'refuse'); !}
go-to: cyprus_campaign_continue
