title: Continue Atilla I
view-if: {! return !!(AnatolianRules.cyprusAtilla1.briefingScene(Q) || AnatolianRules.cyprusAtilla1.historyScene(Q) || AnatolianRules.cyprusAtilla1.scene(Q)); !}
go-to: cyprus_briefing_continue if {! return !!AnatolianRules.cyprusAtilla1.briefingScene(Q); !}; cyprus_history_continue if {! return !AnatolianRules.cyprusAtilla1.briefingScene(Q) && !!AnatolianRules.cyprusAtilla1.historyScene(Q); !}; cyprus_atilla1_ending if {! return !AnatolianRules.cyprusAtilla1.historyScene(Q) && AnatolianRules.cyprusAtilla1.endingReady(Q); !}; cyprus_atilla1_20 if {! return Q.cyprus_month === 7 && Q.cyprus_day === 20 && !Q.cyprus_atilla1_complete && !AnatolianRules.cyprusAtilla1.briefingScene(Q); !}; ayse if cyprus_month == 7 and cyprus_day == 21 and flavour_events and cyprus_atilla1_complete == 0; cyprus_atilla1_21 if cyprus_month == 7 and cyprus_day == 21 and not flavour_events and cyprus_atilla1_complete == 0; cyprus_atilla1_22 if cyprus_month == 7 and cyprus_day == 22 and cyprus_atilla1_complete == 0; cyprus_atilla1_23 if cyprus_month == 7 and cyprus_day == 23 and cyprus_atilla1_complete == 0; plane if cyprus_month == 7 and cyprus_day == 24 and flavour_events and cyprus_atilla1_complete == 0; cyprus_atilla1_24 if cyprus_month == 7 and cyprus_day == 24 and not flavour_events and cyprus_atilla1_complete == 0; root if {! return !AnatolianRules.cyprusAtilla1.briefingScene(Q) && !AnatolianRules.cyprusAtilla1.historyScene(Q) && !AnatolianRules.cyprusAtilla1.scene(Q); !}
