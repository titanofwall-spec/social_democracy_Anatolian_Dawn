@echo off
setlocal EnableExtensions DisableDelayedExpansion
title Anatolian Dawn - Correct Talu advisor cooldown
cd /d "%~dp0"
if not exist "package.json" (
 echo Place this BAT in the root of your Anatolian Dawn repository.
 pause
 exit /b 1
)
where node >nul 2>&1 || (echo ERROR: Node.js required.& pause & exit /b 1)
where git >nul 2>&1 || (echo ERROR: Git required.& pause & exit /b 1)
git diff --quiet && git diff --cached --quiet
if errorlevel 1 (echo ERROR: Commit or stash pending changes first.& pause & exit /b 1)
set "PATCH=%TEMP%\talu_actual_event_%RANDOM%.js"
powershell -NoProfile -ExecutionPolicy Bypass -Command "[IO.File]::WriteAllBytes($env:PATCH,[Convert]::FromBase64String(''))"
if errorlevel 1 goto failed
node "%PATCH%"
set "RC=%ERRORLEVEL%"
del "%PATCH%" >nul 2>&1
if not "%RC%"=="0" goto failed
echo Building game...
call npm run build
if errorlevel 1 goto failed
echo Testing advisor cooldowns...
node scripts\test-advisor-cooldowns.js
if errorlevel 1 goto failed
echo Running complete regression suite...
call npm test
if errorlevel 1 goto failed
git diff --check
if errorlevel 1 goto failed
git diff --stat
choice /C YN /M "Commit and push tested fix to origin/main"
if errorlevel 2 goto done
git add -- out/html/card-actions.js scripts/test-advisor-cooldowns.js
git commit -m "Tie advisor cooldown restoration to Talu cabinet formation"
if errorlevel 1 goto failed
git push origin main
if errorlevel 1 goto failed
echo SUCCESS: Pushed to GitHub.
goto done
:failed
echo.
echo STOPPED: Fix not deployed. Review the error above.
:done
pause
endlocal
