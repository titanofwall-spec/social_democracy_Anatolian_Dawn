title: Economic Health Calculator
view-if: 0
on-arrival: {!
var SYSTEMIC_CRISIS_YEAR_THRESHOLD = 1978;
var FOREX_THRESHOLD_LOW = 40;
var FOREX_THRESHOLD_MID = 60;
var FOREX_THRESHOLD_HIGH = 80;
var FOREX_DISABLE_THRESHOLD = 70;

AnatolianRules.refreshEconomy(Q);

// Preserve the existing four rank names, while using continuously varying scores.
// Piecewise linear anchors prevent a small change in inflation, growth or
// unemployment from suddenly doubling economic damage.
var healthClamp = function(value, lo, hi) { return Math.max(lo, Math.min(hi, value)); };
var healthInterpolate = function(value, anchors) {
    if (!Number.isFinite(value)) return anchors[0][1];
    if (value <= anchors[0][0]) return anchors[0][1];
    for (var i = 1; i < anchors.length; i++) {
        if (value <= anchors[i][0]) {
            var lo = anchors[i - 1], hi = anchors[i];
            return lo[1] + (hi[1] - lo[1]) * (value - lo[0]) / (hi[0] - lo[0]);
        }
    }
    return anchors[anchors.length - 1][1];
};
Q.inflation_score = (!Number.isFinite(Q.inflation) || Q.inflation <= -100)
    ? -10 : healthInterpolate(Q.inflation, [
        [-30, -10], [-20, -8], [-10, -6], [-5, -4], [-2, -2], [0, 0],
        [10, 1], [20, 0], [30, -1], [40, -2], [60, -4], [80, -6], [120, -9]
    ]);
Q.unemployment_score = healthInterpolate(Q.unemployed, [
    [0, 1], [3, 1], [6, 0], [10, -1], [15, -2], [20, -3], [30, -5], [50, -9]
]);
Q.growth_score = !Number.isFinite(Q.economic_growth)
    ? -5 : healthInterpolate(Q.economic_growth, [
        [-10, -6], [-5, -5], [0, -2], [2, -2], [4, -1],
        [6, 0], [8, 1], [10, 2], [15, 0], [30, -5]
    ]);
Q.economy_health_raw = Q.inflation_score + Q.unemployment_score + Q.growth_score;

// Foreign exchange is a smooth, bounded additional strain, not a discrete
// division by 0.6, 0.35 or 0.1 that explosively amplifies negative scores.
var fxStrain = healthClamp((AnatolianRules.number(Q.forex_pressure) - 40) / 60, 0, 1);
Q.forex_multiplier = 1 - 0.65 * fxStrain;
Q.economy_health = Q.economy_health_raw - 3 * fxStrain;
if (Q.forex_pressure >= FOREX_THRESHOLD_HIGH) Q.crisis_forex_flag = 1;

// Rank names remain Booming, Stable, Unhealthy, In Crisis.
// Above 40% CPI inflation is an independent crisis-label trigger, even if
// strong GDP growth and low unemployment mitigate the practical penalties.
if (!Number.isFinite(Q.inflation) || Q.inflation > 40 || Q.economy_health < -5) {
    Q.health_economy_status = "In Crisis";
} else if (Q.economy_health > 3) {
    Q.health_economy_status = "Booming";
} else if (Q.economy_health >= 0) {
    Q.health_economy_status = "Stable";
} else {
    Q.health_economy_status = "Unhealthy";
}

// Gameplay severity does NOT switch formulas when the displayed label changes.
// Near 40% inflation, political penalties change smoothly through that boundary.
// Employment, growth and FX independently adjust the same continuous scale.
var inflationStress = !Number.isFinite(Q.inflation) ? 1.5
    : Q.inflation < 0
        ? 0.75 * healthClamp(-Q.inflation / 20, 0, 1.6)
        : 0.95 * healthClamp((Q.inflation - 15) / 65, 0, 1.6);
var unemploymentStress = 0.35 * healthClamp((AnatolianRules.number(Q.unemployed) - 6) / 14, 0, 2);
var recessionStress = 0.45 * healthClamp((4 - AnatolianRules.number(Q.economic_growth)) / 12, 0, 2);
var growthRelief = 0.12 * healthClamp((AnatolianRules.number(Q.economic_growth) - 4) / 8, 0, 1);
var employmentRelief = 0.09 * healthClamp((6 - AnatolianRules.number(Q.unemployed)) / 6, 0, 1);
var prosperityRelief = 0.20
    * healthClamp((15 - AnatolianRules.number(Q.inflation)) / 15, 0, 1)
    * healthClamp((AnatolianRules.number(Q.economic_growth) - 5) / 5, 0, 1);
var economicStress = inflationStress + unemploymentStress + recessionStress
    + 0.18 * fxStrain - growthRelief - employmentRelief - prosperityRelief;
// Percentage points of government support per half-month turn.
// Capped around the previous maximum crisis/boom effects, without hard steps.
Q.economy_health_political_effect = economicStress >= 0
    ? -0.80 * healthClamp(economicStress, 0, 1)
    : 0.833333 * healthClamp(-economicStress, 0, 1);

// Hard threshold effects
Q.industrial_cards_disabled = (Q.forex_pressure > FOREX_DISABLE_THRESHOLD) ? 1 : 0;
if (Q.economy_health < -7) {
    Q.strike_unrest_risk = 1;
} else {
    Q.strike_unrest_risk = 0;
}
if (Q.economy_health < -10 && Q.year >= SYSTEMIC_CRISIS_YEAR_THRESHOLD) {
    Q.systemic_crisis_mode = 1;
} else if (Q.systemic_crisis_mode && Q.economy_health >= -10) {
    Q.systemic_crisis_mode = 0;
}

// Apply the continuous per-turn political effect to the governing party.
// Direct CHP updates remain disabled when the national coalition model handles votes.
if (Q.apply_economy_effects == 1) {
    var governmentParty = Q.CHP_in_government ? "chp"
        : Q.AP_in_government ? "AP" : Q.DP_in_government ? "DP" : null;
    if (governmentParty) {
        var directEffect = governmentParty === "chp" && Q.national_coalition ? 0
            : Q.economy_health_political_effect;
        ["rural", "workers", "petty_bourgeoisie", "state_employees",
         "capitalists", "alevis", "kurds"].forEach(function(group) {
            var key = group + "_" + governmentParty;
            // Retain the historical double capitalist bonus during prosperity.
            var groupEffect = directEffect * (group === "capitalists" && directEffect > 0 ? 2 : 1);
            Q[key] = AnatolianRules.number(Q[key]) + groupEffect;
        });
    }
}
Q.apply_economy_effects = 0;

!}
go-to: post_event.events_choice if has_event = 1; main if has_event = 0 and difficulty >= 0; main.main_easy if has_event = 0 and difficulty < 0
