@echo off
setlocal EnableExtensions
title Anatolian Dawn - Memorandum Event Formatting Audit
cd /d "%~dp0"
if not exist "package.json" (
 echo Put this BAT in the root of your Anatolian Dawn repository.
 pause
 exit /b 1
)
where node >nul 2>&1 || (echo Node.js is required.& pause & exit /b 1)
where git >nul 2>&1 || (echo Git is required.& pause & exit /b 1)
git diff --quiet && git diff --cached --quiet
if errorlevel 1 (
 echo Uncommitted changes found. Commit or stash them before running this patch.
 pause
 exit /b 1
)
echo Scanning Memorandum event files and applying conservative fixes...
powershell -NoProfile -ExecutionPolicy Bypass -Command "[IO.File]::WriteAllBytes('%TEMP%\anatolian_memorandum_audit.js',[Convert]::FromBase64String(''))"
if errorlevel 1 goto fail
copy /Y "%TEMP%\anatolian_memorandum_audit.js" ".\_memorandum_audit_temp.js" >nul
node "_memorandum_audit_temp.js"
set "RESULT=%ERRORLEVEL%"
del /Q "_memorandum_audit_temp.js" >nul 2>&1
if not "%RESULT%"=="0" goto fail
echo.
git diff --check
if errorlevel 1 goto fail
git diff --stat
echo.
echo Review the changes using: git diff
echo This tool intentionally does NOT automatically commit or push.
echo Run npm run build and npm test after reviewing any changes.
pause
exit /b 0
:fail
echo Formatting audit failed; no deployment attempted.
pause
exit /b 1
