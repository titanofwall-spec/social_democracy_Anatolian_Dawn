title: Continue the Cyprus campaign
on-arrival: {! Q.cyprus_campaign_resume = Q.cyprus_calendar_advance ? 1 : 0; !}
go-to: post_event if cyprus_calendar_advance == 1; cyprus_campaign_final if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q) === 'cyprus_campaign_final'; !}; cyprus_atilla1_ending if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q) === 'cyprus_atilla1_ending'; !}; cyprus_diplomatic_opportunity if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q) === 'cyprus_diplomatic_opportunity'; !}; cyprus_atilla2_14 if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q) === 'cyprus_atilla2_14'; !}; cyprus_atilla2_15 if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q) === 'cyprus_atilla2_15'; !}; cyprus_atilla2_16 if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q) === 'cyprus_atilla2_16'; !}; cyprus_atilla2_ending if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q) === 'cyprus_atilla2_ending'; !}; cyprus_geneva_deadline if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q) === 'cyprus_geneva_deadline'; !}; cyprus_diplomatic_meeting if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q) === 'cyprus_diplomatic_meeting'; !}; cyprus_atilla1_continue if {! return !Q.cyprus_calendar_advance && !AnatolianRules.cyprusCampaign.pending(Q) && !!(AnatolianRules.cyprusAtilla1.briefingScene(Q)||AnatolianRules.cyprusAtilla1.historyScene(Q)||AnatolianRules.cyprusAtilla1.scene(Q)); !}; root if {! return !Q.cyprus_calendar_advance && !AnatolianRules.cyprusCampaign.pending(Q) && !AnatolianRules.cyprusAtilla1.briefingScene(Q)&&!AnatolianRules.cyprusAtilla1.historyScene(Q)&&!AnatolianRules.cyprusAtilla1.scene(Q); !}
