title: Continue Atilla I
view-if: cyprus_mode != 0 and cyprus_year == 1974 and cyprus_month == 7 and cyprus_day >= 20 and cyprus_day <= 25 and cyprus_atilla1_ending_seen == 0
go-to: cyprus_atilla1_ending if cyprus_atilla1_complete == 1 and cyprus_atilla1_ending_seen == 0; cyprus_atilla1_20 if cyprus_day == 20 and cyprus_atilla1_complete == 0; ayse if cyprus_day == 21 and flavour_events and cyprus_atilla1_complete == 0; cyprus_atilla1_21 if cyprus_day == 21 and not flavour_events and cyprus_atilla1_complete == 0; cyprus_atilla1_22 if cyprus_day == 22 and cyprus_atilla1_complete == 0; cyprus_atilla1_23 if cyprus_day == 23 and cyprus_atilla1_complete == 0; plane if cyprus_day == 24 and flavour_events and cyprus_atilla1_complete == 0; cyprus_atilla1_24 if cyprus_day == 24 and not flavour_events and cyprus_atilla1_complete == 0; root if cyprus_atilla1_ending_seen == 1 or cyprus_day < 20 or cyprus_day > 25
