title: Continue the Cyprus campaign
on-arrival: {! Q.cyprus_campaign_resume = Q.cyprus_calendar_advance ? 1 : 0; !}
go-to: cyprus_phantom_convoy if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q)==='cyprus_phantom_convoy'; !}; cyprus_kocatepe_sunk if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q)==='cyprus_kocatepe_sunk'; !}; cyprus_kocatepe_saved if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q)==='cyprus_kocatepe_saved'; !}; cyprus_operation_failure if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q)==='cyprus_operation_failure'; !}; cyprus_taskent if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q)==='cyprus_taskent'; !}; cyprus_geneva_side if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q)==='cyprus_geneva_side'; !}; cyprus_constitution_departure if {! return AnatolianRules.cyprusCampaign.pending(Q)==='cyprus_constitution_departure'; !}; cyprus_roadmap_event if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q)==="cyprus_roadmap_event"; !}; cyprus_roadmap_military if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q)==="cyprus_roadmap_military"; !}; post_event if cyprus_calendar_advance == 1; cyprus_campaign_final if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q) === 'cyprus_campaign_final'; !}; cyprus_atilla1_ending if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q) === 'cyprus_atilla1_ending'; !}; cyprus_diplomatic_opportunity if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q) === 'cyprus_diplomatic_opportunity'; !}; cyprus_atilla2_14 if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q) === 'cyprus_atilla2_14'; !}; cyprus_atilla2_15 if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q) === 'cyprus_atilla2_15'; !}; cyprus_atilla2_16 if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q) === 'cyprus_atilla2_16'; !}; cyprus_atilla2_ending if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q) === 'cyprus_atilla2_ending'; !}; cyprus_geneva_deadline if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q) === 'cyprus_geneva_deadline'; !}; cyprus_diplomatic_meeting if {! return !Q.cyprus_calendar_advance && AnatolianRules.cyprusCampaign.pending(Q) === 'cyprus_diplomatic_meeting'; !}; cyprus_atilla1_continue if {! return !Q.cyprus_calendar_advance && !AnatolianRules.cyprusCampaign.pending(Q) && !!(AnatolianRules.cyprusAtilla1.briefingScene(Q)||AnatolianRules.cyprusAtilla1.historyScene(Q)||AnatolianRules.cyprusAtilla1.scene(Q)); !}; root if {! return !Q.cyprus_calendar_advance && !AnatolianRules.cyprusCampaign.pending(Q) && !AnatolianRules.cyprusAtilla1.briefingScene(Q)&&!AnatolianRules.cyprusAtilla1.historyScene(Q)&&!AnatolianRules.cyprusAtilla1.scene(Q); !}
