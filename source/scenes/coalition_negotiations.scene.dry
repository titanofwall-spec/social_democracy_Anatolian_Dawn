@route
title: Government Formation
new-page: true
go-to: chp_majority if {! return Q.coalition_formation.stage==="mandate"&&Q.chp_seats>=226; !}; ap_majority if {! return Q.coalition_formation.stage==="mandate"&&Q.AP_seats>=226; !}; mandate if {! return Q.coalition_formation.stage==="mandate"&&Q.chp_seats<226&&Q.AP_seats<226; !}; mandate_return if {! return Q.coalition_formation.stage==="return"; !}; mandate_return_final if {! return Q.coalition_formation.stage==="return_final"; !}; talu if {! return Q.coalition_formation.stage==="talu"; !}; waiting if {! return Q.coalition_formation.stage==="waiting_local"; !}; renewed if {! return Q.coalition_formation.stage==="renewed"; !}; right_final if {! return Q.coalition_formation.stage==="right_final"; !}; caretaker if {! return Q.coalition_formation.stage==="caretaker"; !}; formed if {! return Q.coalition_formation.stage==="formed"; !}; attempt if {! return Q.coalition_formation.stage==="attempt"; !}

